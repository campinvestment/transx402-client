{
  "name": "@transx402/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:browser",
    "build:browser": "esbuild src/browser/index.ts --bundle --format=esm --platform=browser --target=es2020 --alias:url=./src/shims/node-url.ts --outfile=dist/transx402.browser.js",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/extensions": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "@x402/paywall": "^2.18.0",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "esbuild": "0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
