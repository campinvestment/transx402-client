{
  "name": "@transx402/client",
  "version": "0.1.0",
  "description": "IDRX x402 payment client for browser and Node.js agents",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+file:///Users/ruby0322/Projects/camp/transx402-client"
  },
  "homepage": "https://docs.transx402.com/integrations/javascript-library",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "default": "./dist/agent/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && pnpm build:browser",
    "build:browser": "esbuild src/browser/index.ts --bundle --format=esm --platform=browser --target=es2020 --alias:url=./src/shims/node-url.ts --alias:buffer=buffer --outfile=dist/transx402.browser.js",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@x402/extensions": "^2.18.0",
    "@x402/fetch": "^2.18.0",
    "buffer": "^6.0.3",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "0.27.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
